---
import { Picture } from 'astro:assets';
import p1 from '../../assets/photos/04-dump-1.jpg';
import p2 from '../../assets/photos/04-dump-2.jpg';
import p3 from '../../assets/photos/04-dump-3.jpg';
import vid from '../../assets/photos/04-video.jpg';
import { WEDDING } from '../../config/wedding';
import type { Copy } from '../../lib/copy';
import Doodle from './Doodle.astro';
import Screen from './Screen.astro';
import { DUMP, ZOOM } from './img';

interface Props { c: Copy; i: number; total: number }
const { c, i, total } = Astro.props;
const yt = WEDDING.youtubeId ? `https://youtu.be/${WEDDING.youtubeId}` : '';
const Tag = yt ? 'a' : 'div';
const alt = `Ảnh cưới ${WEDDING.groom} và ${WEDDING.bride}`;
---
<Screen i={i} total={total} label="Ảnh cưới" class="soft">
  <div class="dump-head">
    <Doodle name="camera" w={40} delay={.2} />
    <h2 class="title">Ảnh cưới</h2>
  </div>
  <div class="grow"></div>
  <div class="grid">
    <button class="frame zoom" type="button" popovertarget="anh1" aria-label="Xem ảnh lớn"><span class="tape" aria-hidden="true"></span><span class="ph"><Picture src={p1} {...DUMP} alt={alt} loading="lazy" /></span></button>
    <button class="frame zoom" type="button" popovertarget="anh2" aria-label="Xem ảnh lớn"><span class="tape" aria-hidden="true"></span><span class="ph"><Picture src={p2} {...DUMP} alt={alt} loading="lazy" /></span></button>
    <Tag class="frame" {...(yt ? { href: yt, target: '_blank', rel: 'noopener', 'aria-label': 'Xem phim cưới trên YouTube' } : {})}>
      <span class="tape" aria-hidden="true"></span>
      <span class="ph">
        <Picture src={vid} {...DUMP} alt="" loading="lazy" />
        {yt && <span class="play" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="#2a2421"></path></svg></span>}
      </span>
      <span class="hw cap" aria-hidden="true">{yt ? 'phim cưới nè' : 'phim cưới sắp có'}</span>
    </Tag>
    <button class="frame zoom" type="button" popovertarget="anh3" aria-label="Xem ảnh lớn"><span class="tape" aria-hidden="true"></span><span class="ph"><Picture src={p3} {...DUMP} alt={alt} loading="lazy" /></span></button>
  </div>
  <!-- bấm ảnh nhỏ → ảnh lớn nổi giữa màn (popover, không JS); bấm bất kỳ đâu, kể cả lên ảnh, là đóng. Đang xem thì thanh story dừng (CSS) -->
  {[p1, p2, p3].map((p, k) => (
    <div id={`anh${k + 1}`} popover class="lb">
      <button type="button" popovertarget={`anh${k + 1}`} popovertargetaction="hide" aria-label="Đóng ảnh"><Picture src={p} {...ZOOM} alt={alt} loading="lazy" /></button>
    </div>
  ))}
  <div class="grow"></div>
  <p class="hw ink dump-note">{c.dumpNote}</p>
</Screen>
