---
import { Image, Picture } from 'astro:assets';
import qr from '../../assets/gift-qr.png';
import b1 from '../../assets/photos/06-booth-1.jpg';
import b2 from '../../assets/photos/06-booth-2.jpg';
import b3 from '../../assets/photos/06-booth-3.jpg';
import { WEDDING } from '../../config/wedding';
import type { Copy } from '../../lib/copy';
import Doodle from './Doodle.astro';
import Screen from './Screen.astro';
import { BOOTH } from './img';

interface Props { c: Copy; i: number; total: number; showGift: boolean; phone: string }
const { c, i, total, showGift, phone } = Astro.props;
const h = WEDDING.helper;
---
<Screen i={i} total={total} label="Hẹn gặp" class="f6">
  <Doodle slot="deco" name="spark" w={14} delay={1.2} class="s6-l" />
  <Doodle slot="deco" name="spark" w={10} delay={1.4} class="s6-r" />
  <svg width="64" height="40" viewBox="0 0 70 44" fill="none" stroke="var(--soft)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="margin-top:6px">
    <path class="draw" pathLength="1" filter="url(#ink)" d="M26 14 A 13 13 0 1 0 26.01 14" style="animation-delay:.3s"></path>
    <path class="draw" pathLength="1" filter="url(#ink)" d="M44 16 A 13 13 0 1 1 43.99 16" style="animation-delay:.7s"></path>
    <path class="draw" pathLength="1" filter="url(#ink)" d="M20 9 L23 4 L29 4 L32 9 L26 14 Z" style="animation-delay:1.1s"></path>
  </svg>
  <h2 class="bye">{c.bye}</h2>
  <p class="s6note">{c.s6note}</p>
  <div class="booth">
    <div class="booth-in">
      <div class="booth-note">
        <!-- quà mừng: hộp quà bên trái dải ảnh (thay nút chữ, 27/11); bấm → thẻ QR nổi giữa màn (popover, không JS) -->
        {showGift ? (
          <button class="gbox" type="button" popovertarget="qua" aria-label={c.giftLabel}><Doodle name="gift" w={50} still /></button>
        ) : (
          <Doodle name="bouquet" w={42} delay={.6} />
        )}
        <p class="hw ink" style="animation-delay:1s">{c.boothNote}</p>
        <svg width="54" height="34" viewBox="0 0 64 40" fill="none" stroke="var(--soft)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path class="draw" pathLength="1" filter="url(#ink)" d="M4 6c18 2 38 10 52 26" style="animation-delay:1.3s"></path>
          <path class="draw" pathLength="1" filter="url(#ink)" d="M46 31l11 2-1-11" style="animation-delay:1.8s"></path>
        </svg>
      </div>
      <div class="strip">
        <div>
          {[b1, b2, b3].map((src) => <Picture src={src} {...BOOTH} alt="" loading="lazy" />)}
        </div>
      </div>
    </div>
  </div>
  <!-- 2 nút dẫn ra ngoài (app Lịch, bản đồ) đặt ở màn cuối, sau hồi âm: khách không rời thiệp trước khi hồi âm (27/11) -->
  <div class="acts">
    <a class="btn" href="/tiec-cuoi.ics">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
      NHẮC MÌNH
    </a>
    <a class="btn" href={WEDDING.venue.mapsUrl} target="_blank" rel="noopener">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l18-8-8 18-2-8z"></path></svg>
      CHỈ ĐƯỜNG
    </a>
  </div>
  <!-- máy không hỗ trợ popover (iOS < 17): thẻ hiện thẳng tại đây, dải ảnh ẩn (CSS @supports) -->
  {showGift && (
    <div id="qua" popover class="gift-card">
      <button class="x" type="button" popovertarget="qua" popovertargetaction="hide" aria-label="Đóng">×</button>
      <Image src={qr} alt="Mã QR chuyển khoản" width={110} height={110} densities={[2]} format="png" loading="lazy" />
      <div style="min-width:0">
        <p style="color:var(--muted)">{WEDDING.gift.bank}</p>
        <p style="font-weight:900">{WEDDING.gift.account}</p>
        <p>{WEDDING.gift.holder}</p>
      </div>
    </div>
  )}
  <div class="fam" style="margin-top:14px">
    <!-- như thiệp mẫu: "Nhà trai/Nhà gái" thư pháp, tên song thân serif -->
    <p><span class="hw">Nhà trai</span> {WEDDING.parents.groom}</p>
    <p><span class="hw">Nhà gái</span> {WEDDING.parents.bride}</p>
    {phone && (
      <p style="margin-top:6px" data-helper>Lạc đường? Gọi {h.name} ({h.role}):
        <a href={`tel:${phone}`}>{phone.replace(/(\d{4})(\d{3})(\d{3})/, '$1 $2 $3')}</a>
      </p>
    )}
  </div>
</Screen>
