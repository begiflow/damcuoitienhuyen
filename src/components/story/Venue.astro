---
import { WEDDING } from '../../config/wedding';
import Doodle from './Doodle.astro';
import { DOODLES, type DoodleName } from './doodles';
import Screen from './Screen.astro';

interface Props { total: number }
const { total } = Astro.props;
const items = WEDDING.schedule;
// Mục nào trùng partyStart (giờ làm lễ) thì khoanh bút
const main = WEDDING.partyStart.slice(11, 16);
// Hình theo việc (thứ tự quan trọng: "Đón khách & teabreak" → tách trà)
const ICONS: [RegExp, DoodleName][] = [
  [/tea|trà/i, 'teacup'], [/đón|đồ uống|cocktail/i, 'martini'], [/lễ|nghi thức|thành hôn/i, 'rings'],
  [/bánh/i, 'cake'], [/nhảy|nhạc|dance/i, 'notes'], [/tiễn|xe hoa|rước/i, 'car'], [/chỗ ngồi|vào bàn/i, 'plate'],
  [/khai tiệc|ly|champagne/i, 'cheers'],
  [/tiệc|lời chúc|dùng bữa/i, 'plate'],
];
const icon = (w: string): DoodleName => ICONS.find(([re]) => re.test(w))?.[1] ?? 'spark';
// cao hình ~34px, rộng theo tỉ lệ viewBox
const iw = (n: DoodleName) => { const [, , w, h] = DOODLES[n].vb.split(' ').map(Number); return Math.min(50, Math.round((34 * w) / h)); };
const gap = 0.45 / Math.max(1, items.length - 1);
---
<Screen i={2} total={total} label="Lịch trình và địa điểm">
  <p class="kicker">{WEDDING.dateDow} · {WEDDING.dateDots}</p>
  <h2 class="title" style="margin-top:10px">Tối hôm ấy</h2>
  <div class="grow"></div>
  <ol class="tl">
    {items.map(({ t, what, note }, n) => (
      <li class={n % 2 ? 'r' : 'l'}>
        <Doodle name={icon(what)} w={iw(icon(what))} delay={+(0.15 + n * gap).toFixed(2)} />
        <div>
          <time>{t === main ? (
            <span class="circ">{t}
              <svg viewBox="0 0 200 60" preserveAspectRatio="none" aria-hidden="true">
                <path class="draw" pathLength="1" filter="url(#ink)" d="M160 8 C 110 0, 30 2, 10 22 C -6 40, 40 58, 110 55 C 180 52, 206 34, 186 16 C 176 8, 150 6, 130 8" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round" vector-effect="non-scaling-stroke" style="animation-delay:1s"></path>
              </svg>
            </span>) : t}</time>
          <span class="what">{what}</span>
          {note && <span class="sub">{note}</span>}
        </div>
      </li>
    ))}
  </ol>
  <div class="grow"></div>
  <p class="venue-name">
    <svg width="14" height="18" viewBox="0 0 24 30" aria-hidden="true"><path d="M12 29s-10-9.5-10-17a10 10 0 0 1 20 0c0 7.5-10 17-10 17z" fill="var(--accent)"></path><circle cx="12" cy="12" r="3.6" fill="var(--paper)"></circle></svg>
    {WEDDING.venue.name.toUpperCase()}
  </p>
  <p class="addr">{WEDDING.venue.address}</p>
  <div class="go">
    <a class="btn" href={WEDDING.venue.mapsUrl} target="_blank" rel="noopener">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l18-8-8 18-2-8z"></path></svg>
      CHỈ ĐƯỜNG
    </a>
    <span class="hw ink" style="animation-delay:1.4s" aria-hidden="true">bấm vô đây</span>
  </div>
  <div class="grow"></div>
</Screen>
