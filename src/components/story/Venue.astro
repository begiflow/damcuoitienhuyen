---
import { Picture } from 'astro:assets';
import bg from '../../assets/photos/03-venue.jpg';
import { WEDDING } from '../../config/wedding';
import Screen from './Screen.astro';
import { FULL } from './img';

interface Props { total: number }
const { total } = Astro.props;
const [first, ...rest] = WEDDING.schedule;
const last = rest.pop();
---
<Screen i={2} total={total} label="Địa điểm">
  <Fragment slot="bg">
    <Picture src={bg} {...FULL} alt="" class="bg" loading="lazy" />
    <div class="shade-t"></div>
    <div class="shade-b" style="--h:55%"></div>
  </Fragment>
  <h2 class="title pop" style="margin-top:20px"><span class="hl">Tiệc ở đây nè</span></h2>
  <div class="venue center pop">
    <p class="sticker" style="margin:0">
      <svg width="18" height="22" viewBox="0 0 24 30" aria-hidden="true" style="flex:0 0 18px"><path d="M12 29s-10-9.5-10-17a10 10 0 0 1 20 0c0 7.5-10 17-10 17z" fill="currentColor"></path><circle cx="12" cy="12" r="3.6" fill="#fff"></circle></svg>
      {WEDDING.venue.name.toUpperCase()}
    </p>
  </div>
  <div class="grow"></div>
  <p class="sched">
    <span class="hl">{first}</span>
    {rest.map((s) => <><br /><span class="hl">{s}</span></>)}
    {last && (
      <>
        <br />
        <span class="circ">
          <span class="hl">{last}</span>
          <svg viewBox="0 0 200 40" preserveAspectRatio="none" aria-hidden="true">
            <path class="draw" pathLength="1" d="M170 6 C 120 -2, 30 0, 8 14 C -6 26, 30 40, 100 38 C 170 36, 206 26, 192 12 C 184 4, 160 3, 140 4" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" vector-effect="non-scaling-stroke" style="animation-delay:.5s"></path>
          </svg>
        </span>
      </>
    )}
  </p>
  <p class="addr">{WEDDING.venue.address}</p>
  <div class="go">
    <a class="pill" href={WEDDING.venue.mapsUrl} target="_blank" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l18-8-8 18-2-8z"></path></svg>
      CHỈ ĐƯỜNG
    </a>
    <svg width="56" height="30" viewBox="0 0 56 30" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex:0 0 56px">
      <path class="draw" pathLength="1" d="M54 6C40 2 22 6 8 20" style="animation-delay:1.1s"></path>
      <path class="draw" pathLength="1" d="M5 10l3 11 11-3" style="animation-delay:1.6s"></path>
    </svg>
    <span class="hw ink" style="animation-delay:1.8s" aria-hidden="true">bấm vô đây</span>
  </div>
</Screen>
