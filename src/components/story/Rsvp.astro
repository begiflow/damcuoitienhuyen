---
import { Picture } from 'astro:assets';
import bg from '../../assets/photos/05-rsvp.jpg';
import type { Copy } from '../../lib/copy';
import Screen from './Screen.astro';
import { FULL } from './img';

interface Props { c: Copy; total: number; diCung: string }
const { c, total, diCung } = Astro.props;
// Mặc định 2 người nếu thiệp ghi "đi cùng", còn lại 1. 4 = "4+".
const defaultCount = diCung ? 2 : 1;
---
<Screen i={4} total={total} label="Xác nhận tham dự" bodyStyle="padding-top:84px">
  <Fragment slot="bg">
    <Picture src={bg} {...FULL} alt="" class="bg" loading="lazy" />
    <div class="dim"></div>
  </Fragment>
  <h2 class="title center pop" style="font-size:28px"><span class="hl">{c.s5title}</span></h2>
  <svg width="140" height="14" viewBox="0 0 160 14" fill="none" aria-hidden="true" class="center" style="margin-top:2px">
    <path class="draw" pathLength="1" d="M2 8 C 20 2, 30 13, 48 7 S 78 2, 96 8 S 128 13, 158 5" stroke="#fff" stroke-width="3" stroke-linecap="round" style="animation-delay:.2s"></path>
  </svg>
  <form class="rsvp pop" id="rsvp" data-pick={c.pickFirst} data-ok={c.thanks} data-err={c.retry} style="pointer-events:auto">
    <div class="card">
      <fieldset style="border:0;margin:0;padding:0;min-width:0">
        <legend class="ask" style="width:100%;padding:0">{c.ask}</legend>
        <p class="due">{c.deadline}</p>
        <input class="sr" type="radio" name="a" value="yes" id="a-yes" /><label class="opt" for="a-yes">{c.yesLabel}</label>
        <input class="sr" type="radio" name="a" value="no" id="a-no" /><label class="opt" for="a-no">{c.noLabel}</label>
      </fieldset>
      <fieldset class="count" style="border:0;margin:0;padding:0;min-width:0">
        <legend class="lbl" style="padding:0">Số người tham dự</legend>
        <div class="nums">
          {[1, 2, 3, 4].map((n) => (
            <><input class="sr" type="radio" name="n" value={n} id={`n-${n}`} checked={n === defaultCount} /><label class="num" for={`n-${n}`}>{n === 4 ? '4+' : n}</label></>
          ))}
        </div>
      </fieldset>
      <div class="note">
        <label for="m">{c.noteLabel}</label>
        <input id="m" name="m" type="text" maxlength="300" autocomplete="off" placeholder="Lời chúc, dẫn bé theo…" />
      </div>
      <button type="submit" class="btn send" disabled>
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true"><path class="draw" pathLength="1" d="M4 12.5l5 5L20 6.5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
        <span>{c.pickFirst}</span>
      </button>
      <p class="sr" role="status" aria-live="polite"></p>
    </div>
  </form>
</Screen>
