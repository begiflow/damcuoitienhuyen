---
import type { Copy } from '../../lib/copy';
import type { Guest } from '../../lib/guests';
import Doodle from './Doodle.astro';
import FillPhoto from './FillPhoto.astro';
import photo from '../../assets/photos/05-rsvp.jpg';
import Screen from './Screen.astro';

interface Props { c: Copy; total: number; guest: Guest }
const { c, total, guest } = Astro.props;
// Mặc định 2 người nếu có "đi cùng" hoặc dòng ghi 2 người ("Dũng & Ngân", xưng hô anh chị), còn lại 1. 4 = "4+".
const defaultCount = guest.diCung || guest.xungHo === 'anhchi' || guest.ten.includes('&') ? 2 : 1;
---
<Screen i={4} total={total} label="Xác nhận tham dự" id="hoi-am">
  <Doodle slot="deco" name="envelope" w={46} delay={.3} class="corner" />
  <p class="kicker">Hồi âm</p>
  <h2 class="title" style="margin-top:10px">{c.s5title}</h2>
  <svg class="under" width="130" height="12" viewBox="0 0 160 14" fill="none" aria-hidden="true">
    <path class="draw" pathLength="1" filter="url(#ink)" d="M2 8 C 20 2, 30 13, 48 7 S 78 2, 96 8 S 128 13, 158 5" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" style="animation-delay:.2s"></path>
  </svg>
  <p class="sub">{c.deadline}</p>
  <form class="rsvp" id="rsvp" data-pick={c.pickFirst} data-ok={c.thanks} data-err={c.retry}>
    <fieldset>
      <legend class="ask">{c.ask}</legend>
      <div class="opts">
        <input class="sr" type="radio" name="a" value="yes" id="a-yes" /><label class="opt" for="a-yes">{c.yesLabel}</label>
        <input class="sr" type="radio" name="a" value="no" id="a-no" /><label class="opt" for="a-no">{c.noLabel}</label>
      </div>
    </fieldset>
    <fieldset class="count">
      <legend class="lbl">Số người tham dự</legend>
      <div class="nums">
        {[1, 2, 3, 4].map((n) => (
          <><input class="sr" type="radio" name="n" value={n} id={`n-${n}`} checked={n === defaultCount} /><label class="num" for={`n-${n}`}>{n === 4 ? '4+' : n}</label></>
        ))}
      </div>
    </fieldset>
    <div class="note">
      <label class="lbl" for="m">{c.noteLabel}</label>
      <input id="m" name="m" type="text" maxlength="300" autocomplete="off" placeholder="Lời chúc, dẫn bé theo…" />
    </div>
    <button type="submit" class="btn send" disabled>
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path class="draw" pathLength="1" d="M4 12.5l5 5L20 6.5" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      <span>{c.pickFirst}</span>
    </button>
    <p class="sr" role="status" aria-live="polite"></p>
  </form>
  <FillPhoto src={photo} rot={-2} />
</Screen>
