---
// Một hình vẽ tay trong doodles.ts. Trang trí thuần: aria-hidden, vẽ dần bằng .draw (ẩn chỉ khi có .js và không giảm chuyển động).
// Nét run nhờ filter #ink định nghĩa 1 lần trong Story.astro. Tổng thời gian vẽ: delay + ~0.8s + 1.1s.
import { DOODLES, type DoodleName } from './doodles';

interface Props { name: DoodleName; w: number; delay?: number; class?: string; style?: string }
const { name, w, delay = 0, class: cls, style } = Astro.props;
const { vb, d } = DOODLES[name];
const [, , vw, vh] = vb.split(' ').map(Number);
const step = Math.min(0.15, 0.8 / d.length);
---
<svg class:list={['dd', cls]} style={style} width={w} height={Math.round((w * vh) / vw)} viewBox={vb} aria-hidden="true">
  <g filter="url(#ink)">
    {d.map((p, k) => (
      <path class:list={['draw', { a: p.startsWith('a:') }]} pathLength="1" d={p.replace(/^a:/, '')} style={`animation-delay:${+(delay + k * step).toFixed(2)}s`}></path>
    ))}
  </g>
</svg>
