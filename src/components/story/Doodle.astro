---
// Một hình vẽ tay trong doodles.ts. Trang trí thuần: aria-hidden, vẽ dần bằng .draw (ẩn chỉ khi có .js và không giảm chuyển động).
// Nét run nhờ filter #ink định nghĩa 1 lần trong Story.astro. Tổng thời gian vẽ: delay + ~0.8s + 1.1s (mảng tô đặc thêm ~0.1s).
import { DOODLES, type DoodleName } from './doodles';

// still: không vẽ dần (hình làm nút bấm: nút không bao giờ ẩn chờ hiệu ứng)
interface Props { name: DoodleName; w: number; delay?: number; class?: string; style?: string; still?: boolean }
const { name, w, delay = 0, class: cls, style, still } = Astro.props;
const { vb, d } = DOODLES[name];
const [, , vw, vh] = vb.split(' ').map(Number);
const step = Math.min(0.15, 0.8 / d.length);
---
<svg class:list={['dd', cls]} style={style} width={w} height={Math.round((w * vh) / vw)} viewBox={vb} aria-hidden="true">
  <g filter="url(#ink)">
    {d.map((p, k) => {
      const t = +(delay + k * step).toFixed(2);
      // tiền tố a: màu nhấn, f: mảng tô đặc (vẽ viền rồi đổ mực: 2 animation, delay riêng), af: cả hai
      const pre = /^([af]+):/.exec(p)?.[1] ?? '';
      const f = pre.includes('f');
      return <path class:list={[{ draw: !still, a: pre.includes('a'), f }]} pathLength="1" d={pre ? p.slice(pre.length + 1) : p} style={still ? undefined : `animation-delay:${f ? `${t}s,${+(t + 0.6).toFixed(2)}s` : `${t}s`}`}></path>;
    })}
  </g>
</svg>
