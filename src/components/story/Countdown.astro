---
import { WEDDING } from '../../config/wedding';
import { googleCalendarUrl } from '../../lib/calendar';
import type { Copy } from '../../lib/copy';
import Doodle from './Doodle.astro';
import photo from '../../assets/photos/02-countdown.jpg';
import Screen from './Screen.astro';

interface Props { c: Copy; total: number }
const { c, total } = Astro.props;
const units = [['d', 'NGÀY'], ['h', 'GIỜ'], ['m', 'PHÚT'], ['s', 'GIÂY']];
// mỗi số nằm trong 1 vòng vẽ tay hơi méo, mỗi vòng một dáng
const rings = [
  'M50 6 C 76 4, 95 24, 94 50 C 93 77, 72 96, 47 94 C 22 92, 5 72, 7 47 C 9 24, 28 8, 54 7',
  'M48 5 C 75 6, 96 27, 93 53 C 90 78, 68 95, 44 92 C 20 89, 4 68, 8 44 C 12 21, 31 6, 52 6',
  'M53 7 C 78 9, 94 30, 92 54 C 90 79, 69 95, 45 93 C 21 91, 6 70, 8 46 C 10 22, 29 5, 50 6',
  'M47 6 C 73 4, 94 25, 95 51 C 96 76, 75 95, 50 94 C 24 93, 6 74, 6 48 C 6 23, 25 7, 51 8',
];
---
<Screen bg={photo} i={1} total={total} label="Đếm ngược" class="soft">
  <Doodle slot="deco" name="disco" w={42} delay={.3} class="w hang" />
  <Doodle slot="deco" name="spark" w={12} delay={.9} class="w hang-s" />
  <p class="kicker">Tiệc cưới {WEDDING.groom} &amp; {WEDDING.bride}</p>
  <div class="cd" data-t={Date.parse(WEDDING.partyStart)} role="timer" aria-label="Thời gian còn lại tới giờ làm lễ và khai tiệc">
    {units.map(([k, l], n) => (
      <div>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <path class="draw" pathLength="1" filter="url(#ink)" d={rings[n]} fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" vector-effect="non-scaling-stroke" style={`animation-delay:${0.4 + n * 0.15}s`}></path>
        </svg>
        <b data-u={k}>–</b><span>{l}</span>
      </div>
    ))}
    <Doodle name="spark" w={14} delay={1} />
  </div>
  <p class="date">{WEDDING.dateLong}</p>
  <p class="when">{WEDDING.partyStart.slice(11, 16)} · {WEDDING.venue.name}</p>
  <p class="lunar">{WEDDING.lunar}</p>
  <p class="kicker">Dress code</p>
  <ul class="dress">{WEDDING.dressCode.map((d) => <li><i style={`--c:${d.mau}`}></i>{d.ten}</li>)}</ul>
  <a class="btn" href={googleCalendarUrl()} target="_blank" rel="noopener">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
    NHẮC MÌNH (LƯU VÀO LỊCH)
  </a>
  <div class="grow"></div>
  <Doodle name="cheers" w={110} delay={.6} class="cheers" />
</Screen>
