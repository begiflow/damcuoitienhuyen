---
import { WEDDING } from '../../config/wedding';
import { googleCalendarUrl } from '../../lib/calendar';
import type { Copy } from '../../lib/copy';
import Screen from './Screen.astro';

interface Props { c: Copy; total: number }
const { c, total } = Astro.props;
const units = [['d', 'NGÀY'], ['h', 'GIỜ'], ['m', 'PHÚT'], ['s', 'GIÂY']];
// mỗi số nằm trong 1 vòng vẽ tay hơi méo, mỗi vòng một dáng
const rings = [
  'M50 6 C 76 4, 95 24, 94 50 C 93 77, 72 96, 47 94 C 22 92, 5 72, 7 47 C 9 24, 28 8, 54 7',
  'M48 5 C 75 6, 96 27, 93 53 C 90 78, 68 95, 44 92 C 20 89, 4 68, 8 44 C 12 21, 31 6, 52 6',
  'M53 7 C 78 9, 94 30, 92 54 C 90 79, 69 95, 45 93 C 21 91, 6 70, 8 46 C 10 22, 29 5, 50 6',
  'M47 6 C 73 4, 94 25, 95 51 C 96 76, 75 95, 50 94 C 24 93, 6 74, 6 48 C 6 23, 25 7, 51 8',
];
---
<Screen i={1} total={total} label="Đếm ngược" class="soft">
  <p class="kicker">Tiệc cưới {WEDDING.groom} &amp; {WEDDING.bride}</p>
  <h2 class="title" style="margin-top:10px">Còn bao lâu nữa?</h2>
  <svg class="under" width="150" height="12" viewBox="0 0 160 14" fill="none" aria-hidden="true">
    <path class="draw" pathLength="1" d="M2 8 C 20 2, 30 13, 48 7 S 78 2, 96 8 S 128 13, 158 5" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" style="animation-delay:.2s"></path>
  </svg>
  <div class="grow"></div>
  <div class="cd" data-t={Date.parse(WEDDING.partyStart)} role="timer" aria-label="Thời gian còn lại tới giờ khai tiệc">
    {units.map(([k, l], n) => (
      <div>
        <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          <path class="draw" pathLength="1" d={rings[n]} fill="none" stroke="var(--accent)" stroke-width="1.6" stroke-linecap="round" vector-effect="non-scaling-stroke" style={`animation-delay:${0.4 + n * 0.15}s`}></path>
        </svg>
        <b data-u={k}>–</b><span>{l}</span>
      </div>
    ))}
  </div>
  <p class="date">{WEDDING.dateLong}</p>
  <p class="lunar">{WEDDING.lunar}</p>
  <a class="btn" href={googleCalendarUrl()} target="_blank" rel="noopener">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path></svg>
    NHẮC MÌNH (LƯU VÀO LỊCH)
  </a>
  <div class="grow"></div>
  <!-- 2 ly chạm nhau, nét vẽ tay -->
  <svg class="cheers" width="120" height="86" viewBox="0 0 120 86" fill="none" stroke="var(--ink)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path class="draw" pathLength="1" d="M30 30 L52 26 L50 44 C 49 52, 40 55, 35 50 C 31 46, 30 38, 30 30 Z M42 52 L46 76 M36 78 L56 74" style="animation-delay:.9s"></path>
    <path class="draw" pathLength="1" d="M90 30 L68 26 L70 44 C 71 52, 80 55, 85 50 C 89 46, 90 38, 90 30 Z M78 52 L74 76 M64 74 L84 78" style="animation-delay:1.1s"></path>
    <path class="draw" pathLength="1" d="M60 6 L60 16 M48 10 L52 18 M72 10 L68 18" stroke="var(--accent)" style="animation-delay:1.6s"></path>
  </svg>
  <p class="hw ink" style="animation-delay:1.4s;margin-top:4px">{c.s2note}</p>
</Screen>
