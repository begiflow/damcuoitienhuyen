---
import { Picture } from 'astro:assets';
import cover from '../../assets/photos/01-cover.jpg';
import type { Copy } from '../../lib/copy';
import Screen from './Screen.astro';
import Signature from './Signature.astro';
import { FULL } from './img';

interface Props { c: Copy; total: number }
const { c, total } = Astro.props;
---
<Screen i={0} total={total} label="Bìa">
  <Fragment slot="bg">
    <Picture src={cover} {...FULL} alt="" class="bg develop" loading="eager" fetchpriority="high" />
    <div class="shade-t"></div>
    <div class="shade-b" style="--h:58%;--a:.6"></div>
  </Fragment>
  <div class="mention pop"><div class="sticker">{c.mention}</div></div>
  <svg width="54" height="44" viewBox="0 0 54 44" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="margin:14px 0 0 6px">
    <path class="draw" pathLength="1" d="M14 4 L16 16 L28 18 L16 20 L14 32 L12 20 L0 18 L12 16 Z" style="animation-delay:.3s"></path>
    <path class="draw" pathLength="1" d="M42 24 L43 30 L49 31 L43 32 L42 38 L41 32 L35 31 L41 30 Z" style="animation-delay:.6s"></path>
  </svg>
  <div class="grow"></div>
  <Signature />
  <h1 class="cover-title pop"><span class="hl">{c.MINH}</span><br /><span class="hl acc">CƯỚI RỒI!</span></h1>
  <p class="hw ink" style="animation-delay:2.3s;margin-top:16px;font-size:19px">{c.s1note}</p>
  <div class="hint bob" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 15l6-6 6 6"></path></svg>
    <span>Vuốt lên hoặc chạm cạnh phải</span>
  </div>
</Screen>
