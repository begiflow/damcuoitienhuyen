---
import { Picture } from 'astro:assets';
import { join } from 'node:path';
import sharp from 'sharp'; // có sẵn: đây là bộ xử lý ảnh mặc định của Astro
import cover from '../../assets/photos/01-cover.jpg';
import { WEDDING } from '../../config/wedding';
import type { Copy } from '../../lib/copy';
import Screen from './Screen.astro';
import Signature from './Signature.astro';
import { COVER } from './img';

interface Props { c: Copy; total: number }
const { c, total } = Astro.props;
// Ảnh bìa siêu mờ 24px (~200 byte) nhúng thẳng vào HTML: khung ảnh có màu thật ngay khi trang hiện,
// rồi ảnh thật đè lên. Ảnh nhỏ thế này Chrome không tính là LCP.
const lqip = (await sharp(join(process.cwd(), 'src/assets/photos/01-cover.jpg')).resize(24).webp({ quality: 40 }).toBuffer()).toString('base64');
---
<Screen i={0} total={total} label="Bìa">
  <p class="kicker">Thiệp mời cưới · {WEDDING.dateDots}</p>
  <div class="frame cover-photo">
    <span class="tape" aria-hidden="true"></span>
    <div class="ph">
      <Picture src={cover} {...COVER} alt={`Ảnh cưới ${WEDDING.groom} và ${WEDDING.bride}`} class="develop" loading="eager" fetchpriority="high" style={`background:url(data:image/webp;base64,${lqip}) center/cover`} />
    </div>
    {c.mention !== '@ban.be' && <span class="mention">{c.mention}</span>}
  </div>
  <Signature />
  <h1 class="cover-title">{c.MINH} <em>CƯỚI RỒI!</em></h1>
  <p class="hw ink" style="animation-delay:2.1s;margin-top:6px">{c.s1note}</p>
  <div class="grow"></div>
  <div class="hint bob" aria-hidden="true">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 15l6-6 6 6"></path></svg>
    <span>VUỐT LÊN</span>
  </div>
</Screen>
