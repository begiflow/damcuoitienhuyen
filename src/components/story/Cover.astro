---
import { join } from 'node:path';
import sharp from 'sharp'; // có sẵn: đây là bộ xử lý ảnh mặc định của Astro
import cover from '../../assets/photos/01-cover.jpg';
import { WEDDING } from '../../config/wedding';
import type { Copy } from '../../lib/copy';
import Screen from './Screen.astro';
import Doodle from './Doodle.astro';

interface Props { c: Copy; total: number }
const { c, total } = Astro.props;
// Ảnh bìa siêu mờ 24px (~200 byte) nhúng thẳng vào HTML: khung ảnh có màu thật ngay khi trang hiện,
// rồi ảnh thật đè lên. Ảnh nhỏ thế này Chrome không tính là LCP.
const lqip = (await sharp(join(process.cwd(), 'src/assets/photos/01-cover.jpg')).resize(24).webp({ quality: 40 }).toBuffer()).toString('base64');
---
<Screen i={0} total={total} label="Bìa" bg={cover} eager lqip={`data:image/webp;base64,${lqip}`}>
  {c.mention !== '@ban.be' && <span slot="deco" class="mention">{c.mention}</span>}
  <Doodle slot="deco" name="martini" w={40} delay={.5} class="w c-tr" />
  <Doodle slot="deco" name="sprig" w={34} delay={.6} class="w c-tl" />
  <Doodle slot="deco" name="spark" w={16} delay={1.2} class="w c-s1" />
  <Doodle slot="deco" name="spark" w={12} delay={1.4} class="w c-s2" />
  <p class="kicker">Thiệp mời cưới · {WEDDING.dateDots}</p>
  <!-- như thiệp mẫu: tên in hoa serif giãn chữ, dấu & cùng font -->
  <h1 class="names">{WEDDING.groom} <span class="amp">&amp;</span> {WEDDING.bride}</h1>
  <p class="cover-title">{c.MINH} <em>CƯỚI&nbsp;RỒI!</em></p>
  <p class="hw ink" style="animation-delay:2.1s;margin-top:6px">{c.s1note}</p>
  <div class="grow"></div>
  <div class="hint bob" aria-hidden="true">
    <span>VUỐT SANG</span>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg>
  </div>
</Screen>
