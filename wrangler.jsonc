// Cloudflare Workers, chỉ phục vụ file tĩnh trong dist/ (không có code chạy phía server).
// Tên phải trùng tên Worker trên dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "damcuoitienhuyen",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // /k/<id> → dist/k/<id>.html, trả 200 trực tiếp
    "html_handling": "auto-trailing-slash",
    // link sai → dist/404.html với mã 404
    "not_found_handling": "404-page"
  }
}
