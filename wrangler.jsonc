// Cloudflare Workers, chỉ phục vụ file tĩnh trong dist/ (không có code chạy phía server).
// Tên phải trùng tên Worker trên dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "damcuoitienhuyen",
  "compatibility_date": "2026-11-01",
  // tên miền riêng (mua trên Cloudflare 28/11). Giữ workers.dev để link đã gửi trước đó vẫn vào được.
  "routes": [
    { "pattern": "tienhuyen.online", "custom_domain": true },
    { "pattern": "www.tienhuyen.online", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // /k/<id> → dist/k/<id>.html, trả 200 trực tiếp
    "html_handling": "auto-trailing-slash",
    // link sai → dist/404.html với mã 404
    "not_found_handling": "404-page"
  }
}
